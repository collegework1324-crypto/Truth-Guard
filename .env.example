# Truth Guard Backend Environment Configuration Template
PROJECT_NAME=Truth Guard
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1

# Security Configuration (Replace SECRET_KEY in production)
SECRET_KEY=your-production-secure-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite local default, PostgreSQL for Railway production)
# Local: sqlite:///./truth_guard.db
# Railway: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./truth_guard.db

# Media Storage Configuration
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=50

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
